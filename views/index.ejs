    <!-- script -->
    <script>
      function toggleOverlay() {
        var real = $('.side-overlay').find('.real');
        var virtual = $('.side-overlay').find('.virtual');
        if (real.hasClass('-translate-x-full')) {
          $('.side-overlay').fadeIn(0);
          virtual.fadeIn(100);
          real.removeClass('-translate-x-full');
          $('body').css('overflow', 'hidden');
        } else {
          virtual.fadeOut(100);
          real.addClass('-translate-x-full');
          $('.side-overlay').fadeOut(150);
          $('body').css('overflow', 'auto');
        }
      }
    </script>


    <!-- tailwind element -->
    <script src="/dist/js/index.min.js"></script>


    <!-- aos -->
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script>
      AOS.init({
        offset: 120,
        duration: 2300
      });
    </script>

    <!-- header fixed -->
    <script>
      window.addEventListener("scroll", () => {
        const windowHeight = window.innerHeight;
        if (window.scrollY >= 0.015 * windowHeight) {
          if (window.innerWidth >= 640) {
            document
              .getElementById("header").style.top = "-51px"
          }
          else {
            document
              .getElementById("header").style.top = "0px"
          }

          document.getElementById("header").style.backgroundColor = "#171819"
        } else {
          document
            .getElementById("header").style.top = "0px"
          document.getElementById("header").style.backgroundColor = "transparent";
        }
      });
    </script>

    <!-- slider -->

    <!-- home setcitno top -->
    <script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
    <script>
      let swiper = new Swiper('.swiper-container', {
        autoplay: {
          delay: 4000,
        },
        effect: "fade",
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        pagination: {
          el: '.swiper-pagination',
        },
        on: {
          slideChangeTransitionStart: function () {
            $('.slider-img').removeClass("slider-image-popup")
            $('.card').hide(0);
            $('.card').removeClass('aos-init').removeClass('aos-animate');

          },
          slideChangeTransitionEnd: function () {
            $('.card').show(0);
            AOS.init();
            $('.slider-img').addClass("slider-image-popup")
          },
        }
      }); 
    </script>

    <!-- home new item list -->
    <script>
      let SP = 3;
      let SF = 40;
      if (window.innerWidth <= 640) {
        SP = 1;
        SF = 0;
      }
      else if (window.innerWidth <= 840) {
        SP = 1.5;
        SF = 0;
      }
      else if (window.innerWidth <= 990) {
        SP = 2;
        SF = 20;
      }
      else if (window.innerWidth <= 1150) {
        SP = 2.4;
        SF = 25;
      }



      let swiper1 = new Swiper(".swiper-new-item-list", {
        slidesPerView: SP,
        spaceBetween: SF,
        slidesPerGroup: 1,
        loop: true,
        autoplay: {
          duration: 2000,
        },
        loopFillGroupWithBlank: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
      });

      // next button home new list item
      function nextSlide1() {
        // console.log(swiper1)
        // alert(swiper1.slides.length)
        swiper1.slideTo((swiper1.activeIndex + 1))
      }
      next.addEventListener("click", nextSlide1);

      function prvSlide1() {
        // alert(swiper1)
        swiper1.slideTo((swiper1.activeIndex - 1))
      }
      prev.addEventListener("click", prvSlide1);
    </script>

    

