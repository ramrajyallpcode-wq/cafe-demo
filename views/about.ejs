        <script>
            AOS.init({
                offset: 120,
                duration: 2300
            });
        </script>


        <!-- header fixed -->
        <script>
            window.addEventListener("scroll", () => {
                const windowHeight = window.innerHeight;
                if (window.scrollY >= 0.015 * windowHeight) {
                    if (window.innerWidth >= 640) {
                        document
                            .getElementById("header").style.top = "-51px"
                    }
                    else {
                        document
                            .getElementById("header").style.top = "0px"
                    }

                    document.getElementById("header").style.backgroundColor = "#171819"
                } else {
                    document
                        .getElementById("header").style.top = "0px"
                    document.getElementById("header").style.backgroundColor = "transparent";
                }
            });
        </script>
        <!-- swiper  -->
        <script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
        <!-- slider what people are saying -->
        <script>
            let SP = 3;
            let SF = 40;
            if (window.innerWidth <= 640) {
                SP = 1;
                SF = 20;
            }
            else if (window.innerWidth <= 840) {
                SP = 1.5;
                SF = 40;
            }
            else if (window.innerWidth <= 990) {
                SP = 2;
                SF = 20;
            }
            else if (window.innerWidth <= 1150) {
                SP = 2.4;
                SF = 25;
            }

            let swiper2 = new Swiper(".swiper-what-people-are-saying", {
                slidesPerView: SP,
                spaceBetween: SF,
                slidesPerGroup: 1,
                loop: true,
                autoplay: {
                    duration: 2000,
                },
                loopFillGroupWithBlank: true,
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
            });

            // next button home new list item
            function nextSlide() {
                swiper2.slideTo((swiper2.activeIndex + 1))

            }
            function prvSlide() {
                swiper2.slideTo((swiper2.activeIndex - 1))
            }
        </script>

        <!-- playYoutubeVideo -->
        <script>
            function playYoutubeVideo(){
                if(window.getComputedStyle(document.getElementById("video-container")).getPropertyValue("display") ==="none"){
                    document.getElementById("video-container").style.display = "block"
                    $('body').css('overflow-y', 'hidden');
                }
                else{
                    document.getElementById("video-container").style.display = "none"
                    $('body').css('overflow-y', 'auto');
                }
            }
        </script>

