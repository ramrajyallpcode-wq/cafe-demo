    <script>
      function showSnackBar(active, content){
        console.log("working");
        $('#snackbar').html(content);
        if(active == "show"){
          $('#snackbar').removeClass('translate-y-80');
          console.log("show");
        }else{
          $('#snackbar').addClass('translate-y-80');
          console.log("hide");
        }
        setTimeout(() => {
          $('#snackbar').addClass('translate-y-80');
        }, 3800);
      }
    </script>
    
    <!-- To use this snackbar Just call this showSnackBar() function where you want 
    Two arguements to pass here...
    1. active = 'hide/show'
    2. content = 'This is Simple Message!'
     
    -->
    
    <script type="text/javascript">
        var message = ('<%= message %>');          
        showAlert = function(message) {
          alert(message);
        }
        if(message && message.length > 0) 
        {  
            showSnackBar("show", message);
        }   
        
    </script>

    <script>
        function showSnackBar(active, content){
        $('#snackbar').html(content);
        if(active == 'show'){
            $('#snackbar').removeClass('translate-y-80');
        }else{
            $('#snackbar').addClass('translate-y-80');
        }
        setTimeout(() => {
            $('#snackbar').addClass('translate-y-80');
        }, 1800);
        }
    </script>

        <!-- script -->
        <script>
            function toggleOverlay() {
                var real = $('.side-overlay').find('.real');
                var virtual = $('.side-overlay').find('.virtual');
                if (real.hasClass('-translate-x-full')) {
                    $('.side-overlay').fadeIn(0);
                    virtual.fadeIn(100);
                    real.removeClass('-translate-x-full');
                    $('body').css('overflow', 'hidden');
                } else {
                    virtual.fadeOut(100);
                    real.addClass('-translate-x-full');
                    $('.side-overlay').fadeOut(150);
                    $('body').css('overflow', 'auto');
                }
            }
        </script>


